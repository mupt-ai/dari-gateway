{
  "name": "@mupt-ai/dari-gateway",
  "version": "0.3.1",
  "description": "Self-hostable LLM gateway for coding agents and APIs: one endpoint for Anthropic Messages, OpenAI Chat Completions, and OpenAI Responses, with subscription pooling, failover, and prompt-cache-aware routing.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mupt-ai/dari-gateway.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bun": {
      "bun": "./src/bun.ts",
      "types": "./dist/bun.d.ts",
      "default": "./dist/bun.js"
    },
    "./*": {
      "bun": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "bin": {
    "dari-gateway": "./dist/self_host/main.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.fixtures.ts",
    "!src/**/*.cases.ts",
    "!src/test_support",
    "!src/**/test_support.ts",
    "dari-gateway.example.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run src/self_host/main.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@aws-sdk/client-sts": "3.1063.0",
    "@mupt-ai/dari-router": "file:../dari-router",
    "@mupt-ai/pi-ai": "1.4.0-mupt.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "typescript": "^5.6.3"
  }
}
